# Jev(TypeSafe) 설정 양식
# 사용법: 이 파일을 같은 폴더에 .env.jev 로 복사한 뒤 아래 키를 채운다.
#   cp .env.jev.example .env.jev
# .env.jev 는 .gitignore 에 등록되어 있어 커밋되지 않는다. 챗봇은 아래 세 값만 읽고, 값을 출력하거나 로그에 남기지 않는다.
#
# 1) 키: '=' 뒤에 붙여 넣기 (따옴표 없이)
TYPESAFE_API_KEY=
#
# 2) 호출 경로 (기본 TypeSafe 직접). LangSmith Gateway를 쓰면 아래 주석을 풀고 키도 LangSmith 키로
# TYPESAFE_BASE_URL=https://gateway.smith.langchain.com
#
# 3) 모델 고정 (재현성). 비우면 jev-latest
# BOT_JEV_MODEL=jev-latest
